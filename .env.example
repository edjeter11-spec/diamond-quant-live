# The Odds API - Get your key at https://the-odds-api.com
THE_ODDS_API_KEY=your_key_here

# Supabase (for real-time collaboration rooms)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini — AI game summaries in PicksBoard (gemini-2.0-flash)
GEMINI_API_KEY=your_key_here

# Optional: OpenWeather for stadium weather
OPENWEATHER_API_KEY=your_key_here

# Discord picks bot bridge — see claude code/quant-picks-bot for the bot itself.
# (Not to be confused with claude code/discord-bot, which is the separate
# Claude Code Discord bridge and has nothing to do with picks.)
# BOT_API_URL is wherever that bot ends up hosted (Railway/Render/always-on
# machine); BOT_API_SECRET must match the same value set in the bot's .env.
BOT_API_URL=your_bot_url_here
BOT_API_SECRET=your_shared_secret_here
